# AC Service Management System - Environment Variables

# Node & Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Business Configuration
BUSINESS_NAME="FrostPro AC Solutions Pvt Ltd"
BUSINESS_TIMEZONE="Asia/Kolkata"
BUSINESS_WORK_START_HOUR=8
BUSINESS_WORK_END_HOUR=20

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acservice_db?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="dev-jwt-access-secret-minimum-32-chars-long-12345"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-minimum-32-chars-long-67890"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Meta WhatsApp Business Cloud API Configuration
# NOTE: Set META_WHATSAPP_ENABLED to false to run the built-in webhook simulator for testing.
META_WHATSAPP_ENABLED=false
META_WHATSAPP_API_VERSION="v21.0"
META_WHATSAPP_PHONE_NUMBER_ID="your-meta-phone-number-id-here"
META_WHATSAPP_WABA_ID="your-whatsapp-business-account-id-here"
META_WHATSAPP_ACCESS_TOKEN="your-permanent-or-system-user-access-token"
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-custom-webhook-verify-token"
META_WHATSAPP_APP_SECRET="your-meta-app-secret-for-sha256-signature-verification"

# Storage Configuration (Local or S3)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
